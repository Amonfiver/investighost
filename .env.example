# Investighost - Configuración de API Keys
# Copiar este archivo a .env y rellenar con tus claves reales
# NUNCA subir .env al repositorio

# Kimi (Moonshot AI) - Proveedor principal
# Obtener en: https://platform.moonshot.cn/
KIMI_API_KEY=sk-your-kimi-api-key-here

# OpenAI - Proveedor fallback (opcional, para futuro)
# Obtener en: https://platform.openai.com/
OPENAI_API_KEY=sk-your-openai-api-key-here

# Modo de depuración (opcional)
DEBUG=false