# Investighost - Configuración local
# Las variables de proveedores de este bloque son legado desactivado y no deben recibir claves.
# NUNCA subir .env al repositorio

# Kimi (Moonshot AI) - legado fail-closed
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
KIMI_MAX_TOKENS=1200

# OpenAI - legado fail-closed. Configurar OpenAI únicamente desde Centro de proveedores.
OPENAI_API_KEY=

# Routing LLM editorial real (no incluir claves aquí: se guardan cifradas en el
# Centro de proveedores). Por defecto: DeepSeek / deepseek-flash.
# DeepSeek para todo:
# INVESTIGHOST_LLM_DEFAULT_PROVIDER=deepseek
# INVESTIGHOST_LLM_DEFAULT_MODEL=deepseek-flash
# OpenAI para todo:
# INVESTIGHOST_LLM_DEFAULT_PROVIDER=openai
# INVESTIGHOST_LLM_DEFAULT_MODEL=gpt-5.6-luna
# Híbrido: DeepSeek analiza/Adventure; OpenAI Student/review.
# INVESTIGHOST_LLM_ANALYSIS_PROVIDER=deepseek
# INVESTIGHOST_LLM_DRAFT_ADVENTURE_PROVIDER=deepseek
# INVESTIGHOST_LLM_DRAFT_STUDENT_PROVIDER=openai
# INVESTIGHOST_LLM_DRAFT_STUDENT_MODEL=gpt-5.6-luna
# INVESTIGHOST_LLM_REVIEW_PROVIDER=openai
# INVESTIGHOST_LLM_REVIEW_MODEL=gpt-5.6-luna
# Opcionales por ruta: _REASONING_EFFORT (none|low|high|max), _TEMPERATURE,
# _TOP_P, _MAX_OUTPUT_TOKENS, _TIMEOUT_MS. No usar temperature y top_p juntos.

# Búsqueda web - Brave Search API (opcional)
# Obtener en: https://brave.com/search/api/
# SEARCH_PROVIDER puede ser: mock | brave
SEARCH_PROVIDER=mock
BRAVE_SEARCH_API_KEY=

# Modo de depuración (opcional)
DEBUG=false

# Diagnóstico IA (opcional): ejecuta una llamada mínima a Kimi antes de investigar
INVESTIGHOST_AI_DIAGNOSTIC=true

# Supabase CLI local exclusivamente. Obtener la clave con `npx supabase status -o env`.
# El proceso principal de Electron es el único consumidor de SERVICE_ROLE; nunca el renderer.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status

# Trawel ingress V2. Solo proceso principal/operador autorizado; nunca renderer,
# preload, payload, outbox ni Git. Debe ser la URL HTTPS completa de la Edge Function.
TRAWEL_INTERNAL_EDITORIAL_DELIVERIES_URL=
TRAWEL_INTERNAL_EDITORIAL_DELIVERIES_SECRET=

# Gate exclusivo de la prueba de conectividad 10D, cerrado por defecto.
INVESTIGHOST_REAL_EXECUTION_TOKEN=

# Gate independiente del piloto editorial real y sus decisiones humanas, cerrado por defecto.
# Se lee únicamente en el proceso principal; no se propaga a preload ni renderer.
# Mantener vacío fuera de la ventana operativa expresamente autorizada.
INVESTIGHOST_REAL_EDITORIAL_TOKEN=

# Capability independiente para jobs editoriales batch reales. Generar un token
# de alta entropía por entorno; no reutilizar tokens de pilotos ni subir valores.
INVESTIGHOST_REAL_BATCH_EXECUTION_TOKEN=

# Timeout por petición Tavily del piloto editorial real (milisegundos).
# Rango admitido: 15000-120000; vacío o inválido aplica el valor seguro 60000.
INVESTIGHOST_REAL_TAVILY_TIMEOUT_MS=
